{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    // I tipi di Vite: senza, `import.meta.env` non esiste per TypeScript e la
    // modalità demo non compila. Portano anche `resolveJsonModule`, che serve
    // a importare le registrazioni.
    "types": ["vite/client"],
    "resolveJsonModule": true
  },
  "include": ["src", "vite.config.ts"]
}
