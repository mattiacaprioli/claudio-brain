# Copia questo file in .env e riempi ANTHROPIC_API_KEY.

DATABASE_URL=postgres://claudio:claudio@localhost:5433/claudio_brain

# Da https://console.anthropic.com -> API keys.
# NB: l'abbonamento di Claude Code non è una API key, serve una key della console.
ANTHROPIC_API_KEY=

# Modello. claude-opus-5 è il più capace; claude-sonnet-5 costa meno.
ANTHROPIC_MODEL=claude-opus-5

# Quanto "ragiona" prima di rispondere: low | medium | high | xhigh | max.
# Sostituisce il vecchio temperature/top_p (che sui modelli attuali danno 400).
ANTHROPIC_EFFORT=medium

# Tetto massimo di token generati in una risposta (è un limite, non un obiettivo).
ANTHROPIC_MAX_TOKENS=16000

# --- Memoria ---------------------------------------------------------------
# Buffer memory: quanti messaggi recenti rimandiamo al modello ad ogni turno.
HISTORY_WINDOW=20

# Summary memory: oltre quanti messaggi non riassunti scatta la sintesi.
# Vincolo obbligatorio: SUMMARY_KEEP_RECENT < SUMMARY_TRIGGER <= HISTORY_WINDOW
# (se non è rispettato l'applicazione non parte, vedi src/config/memory.config.ts).
SUMMARY_TRIGGER=20

# Quanti messaggi restano testuali (non compressi) dopo una sintesi.
SUMMARY_KEEP_RECENT=8

# Modello per i riassunti: compito meccanico, non serve il modello grosso.
ANTHROPIC_SUMMARY_MODEL=claude-haiku-4-5

# --- RAG (Fase 2) ----------------------------------------------------------
# Il RAG richiede un SECONDO provider oltre ad Anthropic (che non offre
# embedding). Finché è 'false' la chat funziona con la sola key Anthropic.
RAG_ENABLED=false

# Key da https://dash.voyageai.com (200M token gratuiti per account).
VOYAGE_API_KEY=

# voyage-code-4 è il modello specializzato sul codice.
# ATTENZIONE: EMBEDDING_DIMENSIONS deve combaciare con vector(N) della
# migration 003, altrimenti Postgres rifiuta ogni insert.
EMBEDDING_MODEL=voyage-code-4
EMBEDDING_DIMENSIONS=1024

# Quanti frammenti passare al modello ad ogni domanda.
RAG_TOP_K=4

# Rate limit di Voyage. I default sono quelli del piano GRATUITO:
# 3 richieste al minuto e 10.000 token al minuto (i 200M token gratuiti
# restano, ma erogati a quella portata). Aggiungendo un metodo di pagamento
# si alzano entrambi e l'ingestion diventa immediata.
EMBEDDING_MAX_TOKENS_PER_REQUEST=4000
EMBEDDING_REQUESTS_PER_MINUTE=3
EMBEDDING_TOKENS_PER_MINUTE=10000

# --- Agente / strumenti (Fase 3) -------------------------------------------
# Tetto ai giri del loop dell'agente: senza, un modello che insiste su uno
# strumento che continua a fallire gira all'infinito bruciando token.
AGENT_MAX_ITERATIONS=6

# URL del servizio in ascolto sul Raspberry Pi. Se vuoto, le azioni hardware
# vengono SIMULATE (e il risultato lo dichiara esplicitamente).
HARDWARE_WEBHOOK_URL=

PORT=3000

# --- Interfaccia (Fase 4) --------------------------------------------------
# Cartella della build del frontend, servita dal backend per avere UNA sola
# origine (il client chiama path relativi: senza origine unica servirebbe CORS).
# Vuoto = `web/dist` accanto al progetto, che è il caso normale. Si valorizza
# nell'immagine Docker, dove la build non sta accanto al sorgente.
# Se la cartella non esiste il backend parte lo stesso, in modalità solo-API:
# in sviluppo è la norma, il frontend gira su Vite con il suo proxy.
WEB_DIST=
